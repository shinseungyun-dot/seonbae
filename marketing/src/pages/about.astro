---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import T from '../components/T.astro';
import { leadership as founders } from '../data/people';

const principles = [
  { title: 'Know who you are learning from', titleKo: '선생님이 믿음직해야 해요', copy: 'Every tutor is verified before appearing on Seonbae. We check academic records and university qualifications before anyone is listed.', copyKo: '부모님이 안심하고 고를 수 있도록 성적부터 대학까지 모두 확인합니다.' },
  { title: 'Firsthand experience makes a difference', titleKo: '선생님도 입시 경험이 있어야 해요', copy: 'Knowing the content and earning the marks are different skills. Recent exam experience helps a tutor give advice that fits the student and the way exams work now.', copyKo: '내용을 아는 것과 점수를 잘 받는 일은 다릅니다. 최근까지 같은 고민을 했던 선배가 학생에게 맞는 입시 지도를 할 수 있습니다.' },
  { title: 'Clear from the start', titleKo: '투명해야 해요', copy: 'Pricing, schedules, lesson expectations, and communication should be easy to understand from the beginning.', copyKo: '가격, 시간대, 수업 내용과 소통 과정까지 모두 투명하고 직관적이어야 합니다.' },
];
---
<Base title="About | Seonbae" active="/about">
  <PageHero
    eyebrow="About"
    eyebrowKo="선배 소개"
    bg="yellow"
    align="center"
    copy="A place where great tutors are valued fairly, families know exactly what they are paying for, and students can learn from people who genuinely understand their path."
    copyKo="좋은 선생님들이 만족스러운 보수로 수업하고, 부모님은 배움의 과정을 확인하며, 학생은 자신의 길을 먼저 걸어본 선배에게 배울 수 있는 곳을 만들었습니다."
  >
    <T en="We built the tutoring platform we wished existed." ko="저희가 필요했던 과외 플랫폼, 저희가 직접 만들었습니다." />
  </PageHero>

  <!-- Editorial layout throughout: a running text measure with a margin rail,
       hairline rules instead of cards. Nothing here is boxed. -->
  <section class="section bg-white" id="founders">
    <div class="container">
      <div class="statement reveal">
        <div class="statement__rail">
          <Eyebrow label="Why we exist" labelKo="우리가 존재하는 이유" />
        </div>
        <div class="statement__body">
          <p class="statement__text"><T en="Great tutors were already out there. The system around them wasn’t working." ko="좋은 선생님들은 많아도, 설 자리가 없었습니다." /></p>
          <p class="statement__text statement__text--two"><T en="Families struggled to know who they could trust and what they were really paying for. Tutors struggled to be found and valued fairly. Seonbae was built to make both sides work better." ko="부모님은 어떤 선생님을 믿고 아이를 맡겨야 할지 고민했고, 선생님은 자신의 가치를 알아주는 일자리를 찾기 어려웠습니다. 선배는 이 문제를 해결하기 위해 시작됐습니다." /></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      <div class="story">
        <div class="story__rail reveal">
          <Eyebrow label="Our start" labelKo="우리의 시작" />
          <p class="story__dateline"><T en="Seoul. Three roommates. One idea." ko="서울의 한 기숙사에서 피어난 생각" /></p>
        </div>
        <div class="story__text reveal">
          <h2 class="h2"><T en="The same problems kept coming up." ko="같은 문제로 셋은 꾸준히 골머리를 앓았습니다." /></h2>
          <p class="story__lede"><T en="The three of us were roommates, and all three of us tutors. After lessons, we often came home talking about the same problems: inconsistent pay, different rates across platforms, scheduling, parent communication, and everything that came with tutoring beyond the teaching itself." ko="저희 셋은 기숙사에서는 룸메이트, 밖에서는 과외 선생님이었습니다. 수업이 끝나면 불규칙한 정산, 플랫폼마다 다른 보수, 갑작스러운 일정 변경과 학부모 소통처럼 수업 이외의 문제를 늘 이야기했습니다. 선생님으로 살며 오히려 가장 쉬운 일은 수업이라고 해도 될 정도였습니다." /></p>
          <figure class="story__photo">
            <img
              src="/images/founders.jpg"
              alt="The three Seonbae founders standing together in university varsity jackets"
              width="1800"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <figcaption><T en="The three of us, before any of this had a name." ko="아직 선배라는 이름이 생기기 전, 세 사람." /></figcaption>
          </figure>
          <p class="body"><T en="We soon realised it wasn’t just us. Tutors across Korea’s top universities teaching international curricula were saying the same things. Those conversations became the first idea for Seonbae. Raphael brought it to Byeongguk and Seung-Yun, and together we started building the platform we wished we had as tutors." ko="저희만 힘든 것이 아니었습니다. 국제 커리큘럼을 가르치는 최상위권 대학 선생님들도 비슷한 어려움을 겪고 있었습니다. 그 대화들이 선배의 첫 아이디어가 되었고, 윤재가 병국과 승윤에게 제안한 뒤 세 사람은 과외 선생님일 때 필요했던 플랫폼을 함께 만들기 시작했습니다." /></p>
          <blockquote class="story__quote"><T en="What would tutoring look like if it actually worked better for everyone involved? That question became Seonbae." ko="선생님과 학생 모두 기분 좋게 가르치고 배울 수 있다면 어떨까요? 선배는 그 질문에 대한 답이 되려 합니다." /></blockquote>
        </div>
      </div>
    </div>

  </section>

  <!-- Founders as full-width rows, read like a masthead rather than a card set. -->
  <section class="section bg-white">
    <div class="container">
      <div class="ed-head reveal">
        <Eyebrow label="The team" labelKo="창업팀" />
        <h2 class="h2"><T en="Meet the founders." ko="창업팀을 소개합니다." /></h2>
      </div>
      <div class="roster-ed">
        {founders.map((f, i) => (
          <article class="fnd reveal" data-delay={`${i * 70}ms`}>
            <span class="fnd__n" aria-hidden="true">{`0${i + 1}`}</span>
            <div class="fnd__id">
              <img class="fnd__portrait" src={f.photo} alt={f.name} width="96" height="96" loading="lazy" decoding="async" />
              <div>
                <h3 class="fnd__name"><T en={`${f.name} ${f.hangul}`} ko={f.hangul} /></h3>
                <p class="fnd__role"><T en={f.role} ko={f.roleKo} /></p>
                <p class="fnd__uni"><T en={f.university} ko={f.universityKo} /></p>
              </div>
            </div>
            <a class="fnd__linkedin" href={f.linkedin} target="_blank" rel="noreferrer" aria-label={`Open ${f.name} on LinkedIn`}>
              <span>LinkedIn</span>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6 14L14 6M14 6H7M14 6V13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- A signed note, so the company page ends in a human voice. -->
  <section class="section bg-white" style="padding-top:0">
    <div class="container">
      <div class="note reveal">
        <div class="note__rail">
          <Eyebrow label="A note from the founders" labelKo="창업팀의 글" />
        </div>
        <div class="note__body">
          <p class="note__lede"><T en="We think tutoring should be straightforward." ko="과외는 투명해야 합니다." /></p>
          <p class="body"><T en="Students should be able to find the right person to learn from. Families should know what to expect. Tutors should be able to focus on teaching. Seonbae is built to make those three things work together." ko="학생은 나에게 맞는 선생님을 쉽게 찾고, 부모님은 투자와 결과 사이의 과정이 합리적인지 확인하며, 선생님은 수업과 학생의 목표에만 몰입할 수 있어야 합니다. 선배는 이 세 가지가 함께 작동하도록 만들었습니다." /></p>
          <p class="note__sign"><T en="The Seonbae founders" ko="선배 창업팀" /></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles as a numbered editorial list, numerals living in the margin. -->
  <section class="section bg-white">
    <div class="container">
      <div class="ed-head reveal">
        <Eyebrow label="What we hold to" labelKo="지키는 원칙" />
        <h2 class="h2"><T en="Three things every tutoring experience should get right." ko="과외가 반드시 갖춰야 할 세 가지." /></h2>
      </div>
      <ol class="tenets">
        {principles.map((p, i) => (
          <li class="tenet reveal" data-delay={`${i * 70}ms`}>
            <span class="tenet__n" aria-hidden="true">{i + 1}</span>
            <h3 class="tenet__t"><T en={p.title} ko={p.titleKo} /></h3>
            <p class="body tenet__c"><T en={p.copy} ko={p.copyKo} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* ----- Statement -------------------------------------------------------- */
  .statement {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .statement__rail { padding-top: 6px; }
  .statement__text {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.4vw, 2.05rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
    max-width: 34ch;
  }
  .statement__text--two { margin-top: 26px; font-weight: 700; }

  /* ----- Story ------------------------------------------------------------ */
  /* Narrower rail than the other sections: this block carries a long read and
     a photo, so the column gets the room and the margin keeps only its label. */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.28fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 96px);
    align-items: start;
  }
  .story__dateline {
    margin-top: 18px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--muted);
    letter-spacing: 0.01em;
  }
  .story__text { max-width: 42rem; border-left: 1px solid var(--line); padding-left: clamp(24px, 3.5vw, 56px); }
  .story__lede { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.62; margin-top: 26px; }
  /* Slightly larger than the site default: the column is wide here, and the
     bigger size keeps the line length near 70 characters rather than 85. */
  .story__text .body { margin-top: 22px; font-size: 1.15rem; line-height: 1.72; }
  /* Founders photo runs in the story text column, so it sits in the reading
     flow at the text measure rather than as a banner hung off the layout. */
  .story__photo { margin: 36px 0 0; }
  .story__photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 12px;
    background: #efe9e0;
  }
  .story__photo figcaption {
    margin-top: 12px;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .story__text .story__photo + .body { margin-top: 34px; }
  .story__quote {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 2px solid var(--ink);
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 1.32;
    letter-spacing: -0.015em;
  }

  /* ----- Section heads ---------------------------------------------------- */
  .ed-head { margin-bottom: clamp(24px, 3.5vw, 44px); padding-bottom: 22px; border-bottom: 2px solid var(--ink); }
  .ed-head .h2 { margin-top: 12px; }

  /* ----- Founders --------------------------------------------------------- */
  .fnd {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: clamp(18px, 3vw, 48px);
    align-items: start;
    padding: clamp(24px, 3vw, 36px) 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .fnd:last-child { border-bottom: none; }
  .fnd__n { font-family: var(--display); font-weight: 800; font-size: 0.95rem; color: var(--violet); padding-top: 6px; }
  .fnd__id { display: flex; gap: 18px; align-items: center; }
  .fnd__portrait { width: 96px; height: 96px; flex: none; border-radius: 50%; object-fit: cover; object-position: center 24%; border: 1px solid var(--line); background: var(--canvas); }
  .fnd__name { font-family: var(--display); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; }
  .fnd__hangul { font-weight: 500; font-size: 0.98rem; color: var(--muted); }
  .fnd__role { color: var(--violet); font-weight: 600; font-size: 0.92rem; margin-top: 5px; }
  .fnd__uni { color: var(--muted); font-size: 0.88rem; margin-top: 1px; }
  .fnd__linkedin { align-self: center; display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 16px; border: 1px solid var(--line); border-radius: var(--r-pill); color: var(--violet); font-weight: 700; font-size: 0.88rem; transition: background 0.16s ease, border-color 0.16s ease; }
  .fnd__linkedin:hover { background: var(--violet-soft); border-color: var(--violet); }
  .fnd__linkedin svg { width: 16px; height: 16px; }

  /* ----- Founders' note --------------------------------------------------- */
  .note {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
    padding-top: clamp(28px, 3.5vw, 44px);
    border-top: 1px solid var(--line);
  }
  .note__body { max-width: 34rem; }
  .note__lede {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .note__body .body + .body { margin-top: 14px; }
  .note__sign {
    margin-top: 24px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .note__sign span { font-weight: 500; font-size: 0.9rem; color: var(--muted); }

  /* ----- Tenets ----------------------------------------------------------- */
  .tenets { display: block; }
  .tenet {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(18px, 3vw, 48px);
    align-items: baseline;
    padding: clamp(26px, 3.2vw, 40px) 0;
    border-top: 1px solid var(--line);
  }
  .tenet:last-child { border-bottom: 1px solid var(--line); }
  .tenet__n {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--violet);
    opacity: 0.36;
  }
  .tenet__t { font-family: var(--display); font-weight: 700; font-size: clamp(1.3rem, 2vw, 1.75rem); letter-spacing: -0.02em; line-height: 1.15; }
  .tenet__c { max-width: 46ch; }

  @media (max-width: 900px) {
    .statement, .story, .note { grid-template-columns: 1fr; }
    .statement__word { font-size: clamp(3.4rem, 18vw, 6rem); }
    .story__text { border-left: none; padding-left: 0; }
    .fnd, .tenet { grid-template-columns: 3rem minmax(0, 1fr); }
    .fnd__linkedin { grid-column: 2; justify-self: start; }
    .fnd__bio, .tenet__c { grid-column: 2; }
    .tenet__n { font-size: 2.2rem; }
  }
  @media (max-width: 560px) {
    .fnd__id { flex-direction: column; align-items: flex-start; gap: 14px; }
  }
</style>
