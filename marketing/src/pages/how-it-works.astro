---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import MediaPanel from '../components/MediaPanel.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';

const steps = [
  { n: '01', title: 'Tell us your goals', titleKo: '목표를 알려주세요', copy: 'Share the subject, the level, and what you are working toward. A test score, a predicted grade, or simply steadier confidence.', copyKo: '과목과 학년, 이루고 싶은 목표를 알려주세요. 시험 점수나 예상 등급, 또는 꾸준한 자신감도 좋습니다.' },
  { n: '02', title: 'See which tutors fit', titleKo: '선배를 찾아드려요', copy: 'See tutors who match your schedule, subject, and level. Every score report has already been verified.', copyKo: '가능한 시간, 과목, 수준에 맞는 선배를 찾아드립니다. 모든 성적표는 미리 검증됩니다.' },
  { n: '03', title: 'Meet your tutor', titleKo: '선배를 만납니다', copy: 'Your first lesson is a real lesson. If the fit is not right, we rematch you, no questions asked.', copyKo: '첫 만남부터 실제 수업을 진행합니다. 잘 맞지 않으면 이유를 묻지 않고 다시 매칭해 드립니다.' },
  { n: '04', title: 'Lesson feedback and assignment check', titleKo: '수업 피드백과 과제 확인', copy: 'Weekly lessons build on each other. Feedback after every session lets students and parents see the progress.', copyKo: '매주 수업이 앞선 내용을 이어갑니다. 수업 뒤 피드백으로 학생과 학부모 모두 성장을 확인할 수 있습니다.' },
];

const inclusions = [
  { title: 'Live one to one lesson', titleKo: '실시간 1대1 수업', copy: 'Work through the subject directly with your tutor on video.', copyKo: '영상으로 선배와 직접 만나 과목을 공부합니다.' },
  { title: 'Lesson recording', titleKo: '수업 녹화', copy: 'Review any part of the lesson again when you need it.', copyKo: '필요한 수업 장면을 언제든 다시 볼 수 있습니다.' },
  { title: 'Lesson materials', titleKo: '수업 자료', copy: 'Your tutor prepares the materials you need for the lesson.', copyKo: '선배가 수업에 필요한 자료를 준비합니다.' },
  { title: 'Lesson feedback', titleKo: '수업 피드백', copy: 'See what you covered, what to practise, and what comes next.', copyKo: '배운 내용과 연습할 것, 다음 단계를 확인합니다.' },
];

const progressSteps = [
  { title: 'Your child sits the check', titleKo: '학생이 점검 시험을 봅니다', copy: 'Short, written, and set on the date you already knew about.', copyKo: '미리 안내한 날짜에 짧은 필기 시험으로 배운 내용을 확인합니다.' },
  { title: 'Your tutor marks it by hand', titleKo: '선배가 직접 채점합니다', copy: 'The same person who taught it, so the feedback knows the history.', copyKo: '가르친 사람이 직접 채점하므로 이전 학습 과정까지 반영한 피드백을 줍니다.' },
  { title: 'It appears in your portal', titleKo: '결과가 포털에 쌓입니다', copy: 'Scored and stacked on the last one, before the next lesson runs.', copyKo: '다음 수업 전에 점수와 피드백이 이전 결과 위에 차곡차곡 쌓입니다.' },
  { title: 'Then it runs again', titleKo: '그리고 다시 반복됩니다', copy: 'Every two, four, or six weeks, for as long as you are with us.', copyKo: '선배와 함께하는 동안 2주, 4주 또는 6주마다 같은 흐름이 이어집니다.' },
];

const portalItems = [
  { icon: 'wallet', title: 'Pay for the month', titleKo: '월간 수업료 결제', copy: 'One invoice, one card, nothing to chase.', copyKo: '한 번의 청구와 한 장의 카드로, 따로 챙길 일이 없습니다.' },
  { icon: 'chart', title: 'See the progress', titleKo: '성장 확인하기', copy: 'Every check plotted against the last, so the direction is obvious.', copyKo: '모든 점검 결과를 이어서 비교하니 성장 방향이 분명하게 보입니다.' },
  { icon: 'notes', title: 'Pick up homework', titleKo: '과제 확인하기', copy: 'Set, submitted, and marked in one place.', copyKo: '출제부터 제출과 채점까지 한곳에서 확인합니다.' },
  { icon: 'board', title: 'Join the lesson', titleKo: '수업 참여하기', copy: 'The same button every week, no links to hunt for.', copyKo: '매주 같은 버튼으로 참여하니 수업 링크를 다시 찾을 필요가 없습니다.' },
];
---
<Base title="How it works | Seonbae" active="/how-it-works">
  <PageHero
    eyebrow="How it works"
    eyebrowKo="이용 안내"
    bg="cream"
    illo="climb"
    illoPos="right"
    copy="Finding the right tutor should feel simple and honest. Here is the process we go through, from the first message to a weekly lesson that holds."
    copyKo="좋은 튜터를 찾는 과정은 투명함에서 시작됩니다. 선배는 첫 문의부터 수업 정산까지 모든 과정을 투명하고 솔직하게 안내합니다."
    ctaLabel="Find a tutor"
    ctaLabelKo="선배 찾기"
    secondaryLabel="See pricing"
    secondaryLabelKo="요금 보기"
    secondaryHref="/pricing"
  >
    <T en="Work towards your goal with the right tutor." ko="맞는 선배와 함께 목표를 향해." />
  </PageHero>

  <section class="section bg-white">
    <div class="container">
      <div class="steps">
        {steps.map((s, i) => (
          <article class="step reveal" data-delay={`${i * 60}ms`}>
            <span class="step__n">{s.n}</span>
            <div class="step__body">
              <h2 class="step__title"><T en={s.title} ko={s.titleKo} /></h2>
              <p class="body"><T en={s.copy} ko={s.copyKo} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container split">
      <div class="reveal">
        <Eyebrow label="Every lesson" labelKo="모든 수업" />
        <h2 class="h2"><T en="What comes with the lesson." ko="수업 구성 전반" /></h2>
        <p class="lead" style="margin-top:18px"><T en="What every lesson holds, whether you book a one-time lesson or have weekly lessons." ko="한 번의 수업이든 매주 이어지는 수업이든, 같은 기준으로 준비합니다." /></p>
        <div class="incl-media" style="margin-top:26px">
          <MediaPanel scene="call" accent="mint" ratio="16 / 7" label="One to one, on video" labelKo="영상으로 만나는 일대일 수업" />
        </div>
      </div>
      <div class="incl-grid reveal" data-delay="80ms">
        {inclusions.map((f) => (
          <article class="incl-card">
            <span class="incl-check" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="18" height="18"><path d="M5 10.5l3 3 7-7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <h3 class="incl-title"><T en={f.title} ko={f.titleKo} /></h3>
              <p class="body"><T en={f.copy} ko={f.copyKo} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white progress-section">
    <div class="container">
      <div class="progress-panel reveal">
        <div class="progress-panel__intro">
          <Eyebrow label="Progress" labelKo="성장" tone="light" />
          <h2><T en="You should not have to wait until the end of term." ko="학기가 끝날 때까지 기다릴 필요가 없습니다." /></h2>
          <p><T en="Your tutor chooses how often to test: every two, four, or six weeks. They set the check, mark it themselves, and upload it, and you watch the results build up in your portal." ko="선배가 2주, 4주 또는 6주 중 점검 주기를 정합니다. 시험을 준비하고 직접 채점해 올리면, 포털에서 결과가 쌓이는 과정을 확인할 수 있습니다." /></p>
          <span class="progress-panel__label"><T en="Your tutor picks one" ko="선배가 주기를 선택합니다" /></span>
          <div class="progress-panel__pills">
            <span><T en="2 weeks" ko="2주" /></span>
            <span><T en="4 weeks" ko="4주" /></span>
            <span><T en="6 weeks" ko="6주" /></span>
          </div>
        </div>
        <div class="progress-panel__steps">
          {progressSteps.map((step, index) => (
            <article class:list={['progress-step', { 'progress-step--cycle': index === progressSteps.length - 1 }]}>
              <span class="progress-step__mark" aria-hidden="true">
                {index < 3 ? index + 1 : (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M20 7v5h-5M4 17v-5h5M6.1 8.2A7 7 0 0118.7 7M5.3 17A7 7 0 0017.9 15.8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
              </span>
              <div>
                <h3><T en={step.title} ko={step.titleKo} /></h3>
                <p><T en={step.copy} ko={step.copyKo} /></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream portal-split-section">
    <div class="container portal-split">
      <div class="portal-split__intro reveal">
        <Eyebrow label="The portal" labelKo="포털" />
        <h2 class="h2"><T en="Everything after the match lives in one place." ko="매칭 이후의 모든 것이 한곳에 있습니다." /></h2>
        <p class="lead"><T en="Most tutoring runs on scattered messages and a transfer somebody has to remember. We put all of it behind one login, for the family and the tutor both." ko="대부분의 과외는 흩어진 메시지와 누군가 기억해야 하는 송금에 기대어 운영됩니다. 선배는 가족과 튜터 모두가 하나의 로그인으로 모든 과정을 확인할 수 있게 했습니다." /></p>
        <div class="cta-row portal-split__actions">
          <Button href="/portal" label="Open the portal" labelKo="포털 열기" variant="primary" size="lg" arrow="diag" />
          <Button href="/get-matched" label="Not matched yet?" labelKo="아직 매칭 전인가요?" variant="text" arrow="right" />
        </div>
      </div>
      <div class="incl-grid portal-feature-grid reveal" data-delay="80ms">
        {portalItems.map((item) => (
          <article class="incl-card portal-feature-card">
            <span class="incl-check" aria-hidden="true"><Icon name={item.icon} size={20} /></span>
            <div>
              <h3 class="incl-title"><T en={item.title} ko={item.titleKo} /></h3>
              <p class="body"><T en={item.copy} ko={item.copyKo} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="verify-teaser has-contour reveal">
        <div class="verify-teaser__text">
          <Eyebrow label="Verification" labelKo="검증" />
          <h2 class="h2"><T en="A tutor is registered only after we have the official score report in our hands." ko="공식 성적표를 직접 확인한 뒤에만 선배로 등록합니다." /></h2>
          <p class="lead" style="margin-top:16px"><T en="Every credential is checked against the real document before a tutor is registered. This is non-negotiable." ko="선배로 등록하기 전에 모든 자격을 실제 서류와 대조합니다. 이 과정은 절대 생략하지 않습니다." /></p>
          <div class="cta-row" style="margin-top:26px">
            <Button href="/verification" label="How we verify" labelKo="검증 방식 보기" variant="secondary" arrow="diag" />
          </div>
        </div>
        <div class="verify-teaser__media">
          <MediaPanel scene="desk" accent="violet" ratio="5 / 4" label="Held in hand" labelKo="직접 확인한 서류" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight bg-white resources-band">
    <div class="container">
      <div class="resources-band__head reveal">
        <div>
          <Eyebrow label="Resources" labelKo="학습 자료" />
          <h2 class="h2"><T en="The people who write the checks also write the guides." ko="점검 시험을 만드는 사람들이 학습 가이드도 씁니다." /></h2>
        </div>
        <p class="lead"><T en="Our research team builds every progress check from a library of past and mock papers, then publishes what they learn as free articles. No account needed, whether you learn with us or not." ko="연구팀은 기출과 모의고사 자료를 바탕으로 모든 점검 시험을 만들고, 그 과정에서 얻은 내용을 무료 글로 공개합니다. 선배와 공부하지 않아도, 계정이 없어도 읽을 수 있습니다." /></p>
      </div>
      <div class="resources-band__foot reveal">
        <div class="resources-band__facts">
          <p><strong>500+</strong><span><T en="past and mock papers behind the checks" ko="점검 시험의 바탕이 된 기출 및 모의고사" /></span></p>
          <p><strong>SKY</strong><span><T en="Seoul National, Korea, and Yonsei students" ko="서울대·고려대·연세대 학생 연구팀" /></span></p>
        </div>
        <Button href="/resources" label="Read the articles" labelKo="학습 자료 읽기" variant="secondary" arrow="diag" />
      </div>
    </div>
  </section>

</Base>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 40px); }
  .step { position: relative; }
  .step__n {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--violet);
    display: inline-block;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 2px solid var(--violet-soft);
    width: 100%;
  }
  .step__title { font-family: var(--display); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; margin-bottom: 10px; }

  .incl-grid { display: flex; flex-direction: column; gap: 14px; }
  .incl-card {
    display: flex;
    gap: 16px;
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    padding: clamp(20px, 2.4vw, 26px);
  }
  /* Same hand-drawn blob as the rest of the site, one tone per row. */
  .incl-check {
    flex: none;
    width: 38px; height: 38px;
    border-radius: var(--check-shape);
    background: var(--check);
    color: var(--ink);
    display: inline-flex; align-items: center; justify-content: center;
    transform: rotate(var(--check-tilt));
  }
  .incl-check :global(svg), .incl-check svg { transform: rotate(calc(var(--check-tilt) * -1)); }
  .incl-card:nth-child(1) { --check: var(--b1); --check-shape: 62% 38% 44% 56% / 38% 58% 42% 62%; --check-tilt: -8deg; }
  .incl-card:nth-child(2) { --check: var(--b2); --check-shape: 38% 62% 68% 32% / 60% 34% 66% 40%; --check-tilt: 10deg; }
  .incl-card:nth-child(3) { --check: var(--b5); --check-shape: 68% 32% 34% 66% / 44% 64% 36% 56%; --check-tilt: -5deg; }
  .incl-card:nth-child(4) { --check: var(--b6); --check-shape: 34% 66% 60% 40% / 66% 38% 62% 34%; --check-tilt: 7deg; }
  .incl-title { font-family: var(--display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.015em; margin-bottom: 6px; }

  .verify-teaser {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    background: var(--canvas);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 56px);
  }

  .progress-panel { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); gap: clamp(34px,6vw,86px); padding: clamp(34px,5.4vw,76px); border-radius: var(--r-xl); background: var(--footer); color: var(--on-dark); }
  .progress-panel__intro h2 { max-width: 13ch; margin-top: 16px; color: var(--on-dark); font-size: clamp(2.25rem,4.3vw,4.1rem); line-height: 1.03; letter-spacing: -.04em; }
  .progress-panel__intro>p { max-width: 33rem; margin-top: 24px; color: var(--on-dark-soft); font-size: 1.04rem; line-height: 1.65; }
  .progress-panel__label { display: block; margin-top: 34px; color: var(--on-dark-soft); font-size: .72rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .progress-panel__pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .progress-panel__pills span { min-width: 112px; padding: 10px 18px; border: 1px solid rgba(240,238,235,.32); border-radius: var(--r-pill); color: var(--on-dark-soft); font-size: .9rem; font-weight: 700; text-align: center; }
  .progress-panel__steps { display: grid; gap: 12px; align-content: center; }
  .progress-step { display: grid; grid-template-columns: 48px minmax(0,1fr); gap: 18px; align-items: start; padding: clamp(20px,2.4vw,28px); border: 1px solid rgba(255,255,255,.14); border-radius: var(--r-lg); background: rgba(255,255,255,.08); }
  .progress-step__mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: rgba(255,255,255,.12); color: var(--on-dark); font-weight: 800; }
  .progress-step h3 { color: var(--on-dark); font-size: 1.08rem; }
  .progress-step p { margin-top: 6px; color: var(--on-dark-soft); font-size: .94rem; line-height: 1.5; }
  .progress-step--cycle { border-color: transparent; background: var(--yellow-soft); }
  .progress-step--cycle .progress-step__mark { background: var(--violet); color: var(--on-dark); }
  .progress-step--cycle h3,.progress-step--cycle p { color: var(--ink); }

  .portal-split { display: grid; grid-template-columns: minmax(0,.88fr) minmax(0,1.12fr); gap: clamp(36px,7vw,96px); align-items: center; }
  .portal-split__intro .h2 { max-width: 15ch; margin-top: 16px; }
  .portal-split__intro>.lead { max-width: 34rem; margin-top: 24px; }
  .portal-split__actions { margin-top: 30px; }
  .portal-feature-grid .portal-feature-card { --check: var(--b1); }
  .portal-feature-grid .portal-feature-card:nth-child(2) { --check: var(--b2); }
  .portal-feature-grid .portal-feature-card:nth-child(3) { --check: var(--b5); }
  .portal-feature-grid .portal-feature-card:nth-child(4) { --check: var(--b6); }

  .resources-band__head { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); gap: clamp(34px,7vw,100px); align-items: end; padding-bottom: clamp(28px,4vw,44px); border-bottom: 2px solid var(--ink); }
  .resources-band__head .h2 { max-width: 15ch; margin-top: 16px; }
  .resources-band__head>.lead { max-width: 44rem; padding-bottom: 4px; }
  .resources-band__foot { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding-top: clamp(28px,4vw,44px); }
  .resources-band__facts { display: flex; flex-wrap: wrap; gap: clamp(24px,5vw,72px); }
  .resources-band__facts p { display: flex; align-items: baseline; gap: 14px; }
  .resources-band__facts strong { color: var(--violet); font-size: clamp(1.8rem,3vw,2.55rem); line-height: 1; letter-spacing: -.04em; }
  .resources-band__facts span { color: var(--muted); font-size: .94rem; }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr 1fr; }
    .verify-teaser { grid-template-columns: 1fr; }
    .verify-teaser__media { order: -1; }
    .progress-panel,.portal-split,.resources-band__head { grid-template-columns: 1fr; }
    .resources-band__foot { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
    .progress-panel { margin-inline: calc(var(--gutter) * -.35); padding: 32px 24px; }
    .progress-panel__pills span { min-width: 0; flex: 1; padding-inline: 10px; }
    .progress-step { grid-template-columns: 42px minmax(0,1fr); gap: 13px; padding: 18px 16px; }
    .resources-band__facts { display: grid; gap: 22px; }
    .resources-band__facts p { align-items: flex-start; flex-direction: column; gap: 6px; }
  }
</style>
