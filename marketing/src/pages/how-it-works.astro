---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import MediaPanel from '../components/MediaPanel.astro';
import T from '../components/T.astro';

const steps = [
  { n: '01', title: 'Tell us your goals', titleKo: '목표를 알려주세요', copy: 'Share the subject, the level, and what you are working toward. A test score, a predicted grade, or simply steadier confidence.', copyKo: '과목과 학년, 이루고 싶은 목표를 알려주세요. 시험 점수나 예상 등급, 또는 꾸준한 자신감도 좋습니다.' },
  { n: '02', title: 'See which tutors fit', titleKo: '선배를 찾아드려요', copy: 'See tutors who match your schedule, subject, and level. Every score report has already been verified.', copyKo: '가능한 시간, 과목, 수준에 맞는 선배를 찾아드립니다. 모든 성적표는 미리 검증됩니다.' },
  { n: '03', title: 'Meet your tutor', titleKo: '선배를 만납니다', copy: 'Your first lesson is a real lesson. If the fit is not right, we rematch you, no questions asked.', copyKo: '첫 만남부터 실제 수업을 진행합니다. 잘 맞지 않으면 이유를 묻지 않고 다시 매칭해 드립니다.' },
  { n: '04', title: 'Lesson feedback and assignment check', titleKo: '수업 피드백과 과제 확인', copy: 'Weekly lessons build on each other. Feedback after every session lets students and parents see the progress.', copyKo: '매주 수업이 앞선 내용을 이어갑니다. 수업 뒤 피드백으로 학생과 학부모 모두 성장을 확인할 수 있습니다.' },
];

const inclusions = [
  { title: 'Live one to one lesson', titleKo: '실시간 1대1 수업', copy: 'Work through the subject directly with your tutor on video.', copyKo: '영상으로 선배와 직접 만나 과목을 공부합니다.' },
  { title: 'Lesson recording', titleKo: '수업 녹화', copy: 'Review any part of the lesson again when you need it.', copyKo: '필요한 수업 장면을 언제든 다시 볼 수 있습니다.' },
  { title: 'Lesson materials', titleKo: '수업 자료', copy: 'Your tutor prepares the materials you need for the lesson.', copyKo: '선배가 수업에 필요한 자료를 준비합니다.' },
  { title: 'Lesson feedback', titleKo: '수업 피드백', copy: 'See what you covered, what to practise, and what comes next.', copyKo: '배운 내용과 연습할 것, 다음 단계를 확인합니다.' },
];
---
<Base title="How it works | Seonbae" active="/how-it-works">
  <PageHero
    eyebrow="How it works"
    eyebrowKo="이용 방법"
    bg="cream"
    illo="climb"
    illoPos="right"
    copy="Finding the right tutor should feel simple and honest. Here is the process we go through, from the first message to a weekly lesson that holds."
    copyKo="좋은 튜터를 찾는 과정은 투명함에서 시작됩니다. 선배는 첫 문의부터 수업 정산까지 모든 과정을 투명하고 솔직하게 안내합니다."
    ctaLabel="Find a tutor"
    ctaLabelKo="선배 찾기"
    secondaryLabel="See pricing"
    secondaryLabelKo="요금 보기"
    secondaryHref="/pricing"
  >
    <T en="Find the right tutor and get started." ko="잘 맞는 선배를 찾고, 함께 시작해 볼게요." />
  </PageHero>

  <section class="section bg-white">
    <div class="container">
      <div class="steps">
        {steps.map((s, i) => (
          <article class="step reveal" data-delay={`${i * 60}ms`}>
            <span class="step__n">{s.n}</span>
            <div class="step__body">
              <h2 class="step__title"><T en={s.title} ko={s.titleKo} /></h2>
              <p class="body"><T en={s.copy} ko={s.copyKo} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container split">
      <div class="reveal">
        <Eyebrow label="Every lesson" labelKo="모든 수업" />
        <h2 class="h2"><T en="What comes with the lesson." ko="수업 구성 전반" /></h2>
        <p class="lead" style="margin-top:18px"><T en="What every lesson holds, whether you book a one-time lesson or have weekly lessons." ko="한 번의 수업이든 매주 이어지는 수업이든, 같은 기준으로 준비합니다." /></p>
        <div class="incl-media" style="margin-top:26px">
          <MediaPanel scene="call" accent="mint" ratio="16 / 7" label="One to one, on video" labelKo="영상으로 만나는 일대일 수업" />
        </div>
      </div>
      <div class="incl-grid reveal" data-delay="80ms">
        {inclusions.map((f) => (
          <article class="incl-card">
            <span class="incl-check" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="18" height="18"><path d="M5 10.5l3 3 7-7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <h3 class="incl-title"><T en={f.title} ko={f.titleKo} /></h3>
              <p class="body"><T en={f.copy} ko={f.copyKo} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="verify-teaser has-contour reveal">
        <div class="verify-teaser__text">
          <Eyebrow label="Verification" labelKo="검증" />
          <h2 class="h2"><T en="A tutor is registered only after we have the official score report in our hands." ko="공식 성적표를 직접 확인한 뒤에만 선배로 등록합니다." /></h2>
          <p class="lead" style="margin-top:16px"><T en="Every credential is checked against the real document before a tutor is registered. This is non-negotiable." ko="선배로 등록하기 전에 모든 자격을 실제 서류와 대조합니다. 이 과정은 절대 생략하지 않습니다." /></p>
          <div class="cta-row" style="margin-top:26px">
            <Button href="/verification" label="How we verify" labelKo="검증 방식 보기" variant="secondary" arrow="diag" />
          </div>
        </div>
        <div class="verify-teaser__media">
          <MediaPanel scene="desk" accent="violet" ratio="5 / 4" label="Held in hand" labelKo="직접 확인한 서류" />
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 40px); }
  .step { position: relative; }
  .step__n {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--violet);
    display: inline-block;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 2px solid var(--violet-soft);
    width: 100%;
  }
  .step__title { font-family: var(--display); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; margin-bottom: 10px; }

  .incl-grid { display: flex; flex-direction: column; gap: 14px; }
  .incl-card {
    display: flex;
    gap: 16px;
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    padding: clamp(20px, 2.4vw, 26px);
  }
  /* Same hand-drawn blob as the rest of the site, one tone per row. */
  .incl-check {
    flex: none;
    width: 38px; height: 38px;
    border-radius: var(--check-shape);
    background: var(--check);
    color: var(--ink);
    display: inline-flex; align-items: center; justify-content: center;
    transform: rotate(var(--check-tilt));
  }
  .incl-check :global(svg), .incl-check svg { transform: rotate(calc(var(--check-tilt) * -1)); }
  .incl-card:nth-child(1) { --check: var(--b1); --check-shape: 62% 38% 44% 56% / 38% 58% 42% 62%; --check-tilt: -8deg; }
  .incl-card:nth-child(2) { --check: var(--b2); --check-shape: 38% 62% 68% 32% / 60% 34% 66% 40%; --check-tilt: 10deg; }
  .incl-card:nth-child(3) { --check: var(--b5); --check-shape: 68% 32% 34% 66% / 44% 64% 36% 56%; --check-tilt: -5deg; }
  .incl-card:nth-child(4) { --check: var(--b6); --check-shape: 34% 66% 60% 40% / 66% 38% 62% 34%; --check-tilt: 7deg; }
  .incl-title { font-family: var(--display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.015em; margin-bottom: 6px; }

  .verify-teaser {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    background: var(--canvas);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 56px);
  }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr 1fr; }
    .verify-teaser { grid-template-columns: 1fr; }
    .verify-teaser__media { order: -1; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
