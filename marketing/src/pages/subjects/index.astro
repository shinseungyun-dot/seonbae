---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SubjectCard from '../../components/SubjectCard.astro';
import T from '../../components/T.astro';

const subjects = (await getCollection('subjects')).sort((a, b) => a.data.order - b.data.order);

const levels = [
  { label: 'Lower secondary', labelKo: '중등 과정', note: 'Grades 6 to 8', noteKo: '6~8학년' },
  { label: 'IGCSE', labelKo: 'IGCSE', note: 'Grades 9 to 10', noteKo: '9~10학년' },
  { label: 'IB and A Level', labelKo: 'IB·A레벨', note: 'Grades 11 to 12', noteKo: '11~12학년' },
  { label: 'University prep', labelKo: '대학 입시 준비', note: 'SAT, ACT, and beyond', noteKo: 'SAT·ACT와 그 이후' },
];
---
<Base title="Subjects — Seonbae" active="/subjects">
  <PageHero
    eyebrow="Subjects"
    eyebrowKo="과목"
    bg="yellow"
    illo="climb"
    illoPos="right"
    copy="Every curriculum a Korean student abroad is likely to sit, taught by tutors who sat it first. Choose a subject to see how lessons are structured and who they are for."
    copyKo="해외에서 공부하는 한국 학생이 만날 주요 커리큘럼을, 같은 시험을 먼저 치른 선배가 가르칩니다. 과목을 선택해 수업 방식과 추천 대상을 확인하세요."
    ctaLabel="Find a tutor"
    ctaLabelKo="선배 찾기"
    secondaryLabel="How it works"
    secondaryLabelKo="이용 방법"
  >
    <T en="Find support for the subject in front of you." ko="지금 마주한 과목에 꼭 맞는 도움을 찾아보세요." />
  </PageHero>

  <section class="section bg-white section--tight">
    <div class="container">
      <div class="levels reveal">
        <span class="levels__label"><T en="Levels we cover" ko="수업 과정" /></span>
        <div class="levels__row">
          {levels.map((l) => (
            <span class="level-pill"><strong><T en={l.label} ko={l.labelKo} /></strong><span><T en={l.note} ko={l.noteKo} /></span></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" style="padding-top:0">
    <div class="container">
      <div class="subject-grid-wrap">
        {subjects.map((s) => (
          <div class="reveal"><SubjectCard entry={s} variant="grid" /></div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .levels { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; }
  .levels__label { font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-soft); font-weight: 600; }
  .levels__row { display: flex; flex-wrap: wrap; gap: 12px; }
  .level-pill {
    display: inline-flex;
    flex-direction: column;
    padding: 10px 18px;
    border-radius: var(--r-md);
    background: var(--violet-soft);
    line-height: 1.25;
  }
  .level-pill strong { font-family: var(--display); font-weight: 700; font-size: 0.98rem; color: var(--violet); }
  .level-pill span { font-size: 0.8rem; color: var(--muted); }

  .subject-grid-wrap {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  @media (max-width: 700px) { .subject-grid-wrap { grid-template-columns: 1fr; } }
</style>
