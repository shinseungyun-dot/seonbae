---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import T from '../components/T.astro';

const checks = [
  { title: 'A relevant score report', titleKo: '성적표', copy: 'Claims are easy to make. Official score reports are not. Tutors submit the original report for every subject they want to teach.', copyKo: '사람의 말보다 증명서가 믿음직합니다. 선배들은 담당 과목의 공식 성적표를 제출해 성적을 확인받습니다.' },
  { title: 'The university', titleKo: '재학 여부', copy: 'A certificate of enrolment, transcript, or admission letter must show attendance at Seoul National University, Yonsei University, or Korea University.', copyKo: '입학통지서, 재학증명서, 성적증명서 중 하나로 SKY 재학 사실을 입증합니다.' },
  { title: 'A teaching sample', titleKo: '시범 수업', copy: 'A short lesson clip shows whether the tutor is ready to teach, not only willing.', copyKo: '과외를 하고 싶은 것과 잘 가르칠 수 있는 것은 다릅니다. 직접 촬영한 강의 영상으로 수업 역량을 평가받습니다.' },
];

// Minimums, not targets. A tutor teaches a subject only if they hold the top
// grade in that subject, so these read as requirements rather than as scores.
const standard = [
  { exam: 'IB Diploma', req: 'A 7 in every subject they teach', reqKo: '가르치는 모든 과목 7점' },
  { exam: 'Advanced Placement', req: 'A 5 in every subject they teach', reqKo: '가르치는 모든 과목 5점' },
  { exam: 'A Level', req: 'An A* in every subject they teach', reqKo: '가르치는 모든 과목 A*' },
  { exam: 'IGCSE', req: 'An A* in every subject they teach', reqKo: '가르치는 모든 과목 A*' },
  { exam: 'SAT', req: '1500 at minimum', reqKo: '최소 1500점' },
  { exam: 'IELTS', req: '8.0 at minimum', reqKo: '최소 8.0점' },
];

const steps = [
  { n: '01', t: 'Application', tKo: '지원', c: 'A tutor applies through the website.', cKo: '웹사이트를 통해 지원합니다.' },
  { n: '02', t: 'Documents checked', tKo: '서류 심사', c: 'We check the tutor’s score reports and university certificates.', cKo: '제출한 서류로 성적과 대학을 확인합니다.' },
  { n: '03', t: 'Sample class', tKo: '시범 수업', c: 'Tutors record a short clip of themselves teaching. We evaluate how they teach.', cKo: '짧은 강의 영상으로 강의 실력을 평가합니다.' },
  { n: '04', t: 'Become a Seonbae', tKo: '합격 이후', c: 'Tutors who complete the screening process can start teaching on the platform.', cKo: '선별 과정이 끝나면 선배에서 수업을 시작합니다.' },
];
---
<Base title="Verification | Seonbae" active="/verification">
  <PageHero
    eyebrow="Verification"
    eyebrowKo="검증"
    bg="white"
    copy="Trust is the whole product."
    copyKo="성적 증명과 면접을 통과한 선생님들만이 여러분과 함께할 자격을 얻습니다."
    ctaLabel="Get matched"
    ctaLabelKo="매칭 시작하기"
    secondaryLabel="Meet the tutors"
    secondaryLabelKo="선배 만나보기"
    secondaryHref="/tutors"
  >
    <T en="Every tutor, verified." ko="검증된 선배들과 함께하세요." />
  </PageHero>

  <!-- One sheet, not four cards: the page's argument is that a real document
       exists, so the section is shaped like a document. -->
  <section class="section bg-white">
    <div class="container">
      <div class="dossier reveal">
        <div class="dossier__head">
          <div>
            <Eyebrow label="Held on file" labelKo="보관·확인" />
            <h2 class="dossier__title"><T en="Three things we check before a tutor is listed." ko="선배가 되기까지 확인하는 세 가지." /></h2>
          </div>
          <!-- A rectangular ink stamp rather than a seal: double rule, flat
               caps, set a couple of degrees off square. Reads like something
               pressed onto a document, which is what the sheet is imitating. -->
          <span class="stamp" aria-hidden="true">
            <span class="stamp__box">
              <span class="stamp__word"><T en="Verified" ko="검증 완료" /></span>
              <span class="stamp__meta"><T en="Seonbae · held on file" ko="선배 · 서류 확인" /></span>
            </span>
          </span>
        </div>

        <ol class="dossier__list">
          {checks.map((c, i) => (
            <li class="hold">
              <span class="hold__n" aria-hidden="true">{`0${i + 1}`}</span>
              <h3 class="hold__t"><T en={c.title} ko={c.titleKo} /></h3>
              <p class="hold__c"><T en={c.copy} ko={c.copyKo} /></p>
            </li>
          ))}
        </ol>

        <p class="dossier__foot"><T en="Held on file, not taken on trust. Every item above is checked by a person before a profile goes live." ko="말만 믿지 않고 서류를 보관합니다. 프로필을 공개하기 전에 담당자가 위 항목을 모두 확인합니다." /></p>
      </div>
    </div>
  </section>

  <!-- The entry requirement, stated as requirements rather than as a scoreboard
       of numbers. A contained panel, so the dark does not swallow the page. -->
  <section class="section section--tight bg-white">
    <div class="container">
      <div class="sp reveal">
        <div class="sp__intro">
          <div>
            <Eyebrow label="Entry requirement" labelKo="등록 기준" tone="light" />
            <h2 class="sp__title"><T en="A floor higher than most ceilings." ko="학생들이 우러러볼 수 있는 기준." /></h2>
          </div>
          <p class="sp__copy"><T en="Tutors are accepted only for subjects in which they hold the top grade. This is our standard." ko="선배들은 담당 과목의 정상까지 올랐던 분들입니다. 최고에게서 배워야 최고가 됩니다." /></p>
        </div>
        <dl class="sp__list">
          {standard.map((s) => (
            <div class="sp__row">
              <dt class="sp__exam">{s.exam}</dt>
              <dd class="sp__req"><T en={s.req} ko={s.reqKo} /></dd>
            </div>
          ))}
        </dl>
        <p class="sp__note"><T en="Each requirement is checked against the original document before a tutor is listed." ko="명부 등록 전에 모든 기준을 원본 서류와 대조합니다." /></p>
      </div>
    </div>
  </section>

  <!-- The sequence gets a literal spine, so the order is impossible to miss. -->
  <section class="section bg-white">
    <div class="container">
      <div class="spine-head reveal">
        <Eyebrow label="The process" labelKo="검증 절차" />
        <h2 class="h2"><T en="Our screening process." ko="튜터 선별 과정." /></h2>
      </div>

      <ol class="spine">
        {steps.map((s, i) => (
          <li class={`stop ${i % 2 === 0 ? 'stop--l' : 'stop--r'} reveal`} data-delay={`${i * 70}ms`}>
            <span class="stop__dot" aria-hidden="true"></span>
            <div class="stop__card">
              <span class="stop__n">{s.n}</span>
              <h3 class="stop__t"><T en={s.t} ko={s.tKo} /></h3>
              <p class="body"><T en={s.c} ko={s.cKo} /></p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tight bg-white">
    <div class="container">
      <div class="safe reveal">
        <div class="safe__head">
          <Eyebrow label="Safeguarding and privacy" labelKo="학생 보호와 개인정보" />
          <h2 class="h2" style="margin-top:12px"><T en="Safety is our priority." ko="안전 방침" /></h2>
        </div>
        <dl class="safe__list">
          <div class="safe__row">
            <dt><T en="Lessons are recorded" ko="모든 수업이 녹화됩니다" /></dt>
            <dd><T en="We record lessons for revision and safety. Supervision helps us maintain a safe learning environment." ko="복습을 위해 녹화하며, 필요한 상황에서는 안전을 지키는 중요한 기록이 됩니다." /></dd>
          </div>
          <div class="safe__row">
            <dt><T en="Your data, on request, gone" ko="요청하면 개인정보를 삭제합니다" /></dt>
            <dd><T en="Ask us to delete your data and we act within two working days, keeping only the records the law requires us to hold." ko="정보 삭제를 요청하면 세무와 회계 법령상 필요한 기록을 제외하고 영업일 기준 이틀 안에 삭제합니다." /></dd>
          </div>
          <div class="safe__row">
            <dt><T en="The safeguarding team" ko="학생 보호팀" /></dt>
            <dd><T en="Our Chief Operating Officer owns this personally. Write to " ko="COO가 직접 책임집니다. " /><a href="mailto:admissions@seonbaetutor.com">admissions@seonbaetutor.com</a><T en=" and it reaches him." ko="으로 보내면 바로 전달됩니다." /></dd>
          </div>
        </dl>
        <div class="safe__cta">
          <Button href="/tutors" label="Meet the verified tutors" labelKo="검증된 선배 만나보기" variant="secondary" arrow="diag" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- Dossier sheet ---------------------------------------------------- */
  .dossier {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 60px);
    box-shadow: var(--shadow-sm);
  }
  .dossier__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(20px, 4vw, 48px);
    align-items: start;
    padding-bottom: 26px;
    border-bottom: 2px solid var(--ink);
  }
  .dossier__title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin-top: 14px;
    max-width: 20ch;
  }
  .stamp { flex: none; padding: 6px 4px; }
  .stamp__box {
    display: inline-block;
    padding: 12px 20px 11px;
    border: 2px solid var(--violet);
    box-shadow: inset 0 0 0 1px rgba(18, 60, 94, 0.26);
    border-radius: 3px;
    color: var(--violet);
    text-align: center;
    transform: rotate(-2.5deg);
    opacity: 0.85;
  }
  .stamp__word {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
  }
  .stamp__meta {
    display: block;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(18, 60, 94, 0.3);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dossier__list { margin-top: 4px; }
  .hold {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(14px, 2.5vw, 36px);
    align-items: baseline;
    padding: clamp(20px, 2.4vw, 28px) 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .hold:last-child { border-bottom: none; }
  .hold__n { font-family: var(--display); font-weight: 800; font-size: 0.92rem; color: var(--violet); }
  .hold__t { font-family: var(--display); font-weight: 700; font-size: 1.16rem; letter-spacing: -0.018em; line-height: 1.2; }
  .hold__c { color: var(--muted); font-size: 0.99rem; line-height: 1.58; }
  .dossier__foot {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* ----- Entry requirement panel ------------------------------------------ */
  .sp {
    background: var(--footer);
    color: var(--on-dark);
    border-radius: var(--r-xl);
    padding: clamp(30px, 4vw, 52px);
  }
  .sp__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(18px, 4vw, 56px);
    align-items: end;
    padding-bottom: clamp(24px, 3vw, 34px);
    border-bottom: 1px solid var(--line-dark);
  }
  .sp__title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--on-dark);
    margin-top: 14px;
  }
  .sp__copy { color: var(--on-dark-soft); font-size: 1rem; line-height: 1.6; max-width: 46ch; }
  .sp__note {
    margin-top: clamp(20px, 3vw, 30px);
    padding-top: 18px;
    border-top: 1px solid var(--line-dark);
    font-size: 0.86rem;
    color: var(--on-dark-soft);
  }

  /* Three across, two down: fills the panel instead of leaving a hole under
     the second column. */
  .sp__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 34px) clamp(20px, 4vw, 48px);
    margin-top: clamp(24px, 3vw, 34px);
  }
  .sp__row { padding-left: 14px; border-left: 2px solid var(--yellow-soft); }
  .sp__exam {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.015em;
    color: var(--on-dark);
  }
  .sp__req { margin-top: 4px; color: var(--on-dark-soft); font-size: 0.93rem; line-height: 1.45; }

  /* ----- Process spine ---------------------------------------------------- */
  .spine-head { margin-bottom: clamp(28px, 4vw, 52px); }
  .spine-head .h2 { margin-top: 12px; }
  .spine { position: relative; padding-block: 4px; }
  .spine::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: linear-gradient(180deg, var(--violet-soft), var(--violet) 12%, var(--violet) 88%, transparent);
  }
  .stop { position: relative; display: grid; grid-template-columns: 1fr 1fr; padding-block: clamp(10px, 1.6vw, 20px); }
  .stop__dot {
    position: absolute;
    left: 50%;
    top: clamp(24px, 3vw, 34px);
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    border-radius: 50%;
    background: var(--violet);
    box-shadow: 0 0 0 5px var(--white);
  }
  .stop__dot--end { background: var(--white); border: 2px solid var(--violet); }
  .stop--l .stop__card { grid-column: 1; text-align: right; padding-right: clamp(28px, 4vw, 56px); }
  .stop--r .stop__card { grid-column: 2; padding-left: clamp(28px, 4vw, 56px); }
  .stop--end .stop__card { grid-column: 1; text-align: right; padding-right: clamp(28px, 4vw, 56px); }
  .stop__n { font-family: var(--display); font-weight: 800; font-size: 0.9rem; color: var(--violet); letter-spacing: 0.04em; }
  .stop__t { font-family: var(--display); font-weight: 700; font-size: clamp(1.25rem, 2vw, 1.6rem); letter-spacing: -0.02em; margin: 8px 0 10px; }
  .stop__card .body { max-width: 38ch; }
  .stop--r .stop__card .body { margin-right: auto; }
  .stop--l .stop__card .body, .stop--end .stop__card .body { margin-left: auto; }
  .stop__end { font-family: var(--display); font-weight: 700; font-size: 1.05rem; color: var(--violet); }

  /* ----- Safeguarding ----------------------------------------------------- */
  .safe { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(24px, 5vw, 72px); align-items: start; }
  .safe__head { position: sticky; top: 112px; }
  .safe__list { border-top: 2px solid var(--ink); }
  .safe__row { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(14px, 3vw, 36px); padding: 22px 0; border-bottom: 1px solid var(--line-soft); }
  .safe__row dt { font-family: var(--display); font-weight: 700; font-size: 1.02rem; letter-spacing: -0.015em; line-height: 1.3; }
  .safe__row dd { color: var(--muted); font-size: 0.99rem; line-height: 1.58; }
  .safe__row dd a { color: var(--violet); text-decoration: underline; text-underline-offset: 3px; }
  .safe__cta { grid-column: 2; margin-top: 26px; }

  @media (max-width: 900px) {
    .dossier__head { grid-template-columns: 1fr; }
    .stamp__box { padding: 10px 15px 9px; }
    .stamp__meta { font-size: 0.6rem; }
    .hold { grid-template-columns: 2.5rem minmax(0, 1fr); row-gap: 8px; }
    .hold__c { grid-column: 2; }
    .sp__intro { grid-template-columns: 1fr; align-items: start; }
    .sp__list { grid-template-columns: 1fr 1fr; }

    .spine::before { left: 7px; }
    .stop { grid-template-columns: 1fr; }
    .stop__dot { left: 7px; top: 22px; }
    .stop--l .stop__card,
    .stop--r .stop__card,
    .stop--end .stop__card { grid-column: 1; text-align: left; padding: 0 0 0 34px; }
    .stop--l .stop__card .body, .stop--end .stop__card .body { margin-left: 0; }

    .safe { grid-template-columns: 1fr; }
    .safe__head { position: static; }
    .safe__row { grid-template-columns: 1fr; row-gap: 8px; }
    .safe__cta { grid-column: 1; }
  }
</style>
