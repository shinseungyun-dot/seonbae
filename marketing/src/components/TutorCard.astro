---
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';

interface Props { entry: CollectionEntry<'tutors'>; }
const { entry } = Astro.props;
const t = entry.data;
---
<article class="tutor-card card">
  <div class="tutor-head">
    <Avatar name={t.name} accent={t.accent} size={64} />
    <div class="tutor-id">
      <h3 class="tutor-name">{t.name} {t.hangul && <span class="kr tutor-hangul">{t.hangul}</span>}</h3>
      <p class="tutor-uni">{t.university}</p>
    </div>
    <span class="verified" title="Verified by Seonbae">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 2l2.4 1.8 3 .2.9 2.8 2.4 1.7-.9 2.9.9 2.9-2.4 1.7-.9 2.8-3 .2L12 22l-2.4-1.8-3-.2-.9-2.8L3.3 15.3l.9-2.9-.9-2.9 2.4-1.7.9-2.8 3-.2z" fill="currentColor"/><path d="M8.5 12l2.3 2.3 4.7-4.8" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Verified
    </span>
  </div>

  <div class="tutor-creds">
    {t.credentials.slice(0, 2).map((c) => <span class="pill pill--violet">{c}</span>)}
  </div>

  <p class="tutor-style body">{t.teachingStyle}</p>

  <div class="tutor-specialty">
    {t.specialty.map((s) => <span class="tag">{s}</span>)}
  </div>

  <div class="tutor-foot">
    <p class="tutor-meta">{t.languages.join(' · ')}<br /><span>{t.availability}</span></p>
    <a href="/get-matched" class="textlink">Request
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</article>

<style>
  .tutor-card { display: flex; flex-direction: column; padding: clamp(22px, 2.4vw, 28px); height: 100%; }
  .tutor-head { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; }
  .tutor-name { font-family: var(--display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em; line-height: 1.15; }
  .tutor-hangul { font-weight: 500; font-size: 0.95rem; color: var(--muted); margin-left: 3px; }
  .tutor-uni { font-size: 0.9rem; color: var(--muted); margin-top: 2px; }
  .verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    align-self: start;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--violet);
    background: var(--violet-soft);
    padding: 5px 9px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }
  .verified svg { color: var(--violet); }
  .tutor-creds { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .tutor-style { margin-top: 16px; font-size: 0.98rem; flex: 1; }
  .tutor-specialty { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tag {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
    background: rgba(12, 12, 12, 0.05);
    padding: 5px 10px;
    border-radius: 8px;
  }
  .tutor-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line-soft);
  }
  .tutor-meta { font-size: 0.85rem; color: var(--ink); font-weight: 500; line-height: 1.5; }
  .tutor-meta span { color: var(--muted); font-weight: 400; }
</style>
