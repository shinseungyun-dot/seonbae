---
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import MediaPanel from './MediaPanel.astro';

interface Props { entry: CollectionEntry<'plans'>; }
const { entry } = Astro.props;
const p = entry.data;
---
<article class:list={['plan', { 'plan--featured': p.featured, 'plan--wide': p.wide }]}>
  <div class="plan__main">
    {p.featured && <span class="plan__badge">Most chosen</span>}
    <h3 class="plan__name">{p.name}</h3>
    <p class="plan__tagline">{p.tagline}</p>

    <!-- No single figure here: every subject carries its own hourly rate, so
         the card points at the rate card instead of quoting an average. -->
    <div class="plan__price">
      <span class="plan__from">Hourly rate</span>
      <span class="plan__amount">By subject</span>
      <span class="plan__unit">Each subject is priced on its own. <a href="/pricing#all-rates">See the rate card</a></span>
    </div>
    <p class="plan__billing">{p.billingMonthly}</p>

    <ul class="plan__features">
      {p.features.map((f) => (
        <li>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="var(--violet-soft)"/><path d="M6 10.5l2.6 2.6L14 7.5" fill="none" stroke="var(--violet)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{f}</span>
        </li>
      ))}
    </ul>

    <div class="plan__cta">
      <Button href={p.ctaHref} label={p.ctaLabel} variant={p.featured ? 'primary' : 'secondary'} size="lg" arrow="diag" />
    </div>
  </div>

  {p.wide && (
    <div class="plan__media">
      <MediaPanel scene="desk" accent="butter" ratio="1 / 1" label="A plan you can see" />
    </div>
  )}
</article>

<style>
  .plan {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(26px, 3vw, 40px);
    height: 100%;
  }
  .plan--featured {
    border-color: var(--violet);
    box-shadow: 0 20px 50px rgba(0, 58, 108, 0.16);
  }
  .plan--wide { grid-template-columns: 1.25fr 0.85fr; gap: clamp(24px, 4vw, 48px); align-items: center; }
  .plan__main { display: flex; flex-direction: column; }
  .plan__badge {
    align-self: flex-start;
    background: var(--violet);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    margin-bottom: 16px;
  }
  .plan__name { font-family: var(--display); font-weight: 800; font-size: clamp(1.5rem, 2.2vw, 2rem); letter-spacing: -0.02em; }
  .plan__tagline { color: var(--muted); margin-top: 10px; max-width: 42ch; }
  .plan__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .plan__from { color: var(--muted); font-weight: 500; }
  .plan__amount { font-family: var(--display); font-weight: 800; font-size: clamp(1.9rem, 2.8vw, 2.5rem); letter-spacing: -0.03em; }
  .plan__unit { color: var(--muted); font-size: 0.9rem; width: 100%; }
  .plan__unit a { color: var(--violet); text-decoration: underline; text-underline-offset: 3px; }
  .plan__billing { margin-top: 10px; font-size: 0.92rem; color: var(--violet); font-weight: 500; }
  .plan__features { display: flex; flex-direction: column; gap: 12px; margin-top: 26px; flex: 1; }
  .plan__features li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.98rem; color: var(--ink); }
  .plan__features svg { flex: none; margin-top: 1px; }
  .plan__cta { margin-top: 30px; }

  @media (max-width: 780px) {
    .plan--wide { grid-template-columns: 1fr; }
    .plan__media { order: -1; }
  }
</style>
