---
// KO / EN language switch. Active state is driven entirely by html[data-lang]
// (see global.css), so it stays correct across pages without JS re-render.
// The click handler + no-flash default live in Base.astro.
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<div class:list={['langtoggle', cls]} role="group" aria-label="Language / 언어">
  <button type="button" data-set-lang="ko" lang="ko">한국어</button>
  <button type="button" data-set-lang="en" lang="en">EN</button>
</div>

<style>
  .langtoggle {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    background: rgba(12, 12, 12, 0.05);
    border-radius: var(--r-pill);
    gap: 2px;
    flex: none;
  }
  .langtoggle button {
    border: none;
    background: none;
    padding: 6px 11px;
    border-radius: var(--r-pill);
    font-family: var(--body);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
    line-height: 1;
  }
  .langtoggle button[lang='ko'] { font-family: var(--kr); }
  .langtoggle button:hover { color: var(--ink); }

  /* Active pill, chosen purely from the root language flag. Default = EN. */
  html[data-lang='ko'] .langtoggle [data-set-lang='ko'],
  html:not([data-lang='ko']) .langtoggle [data-set-lang='en'] {
    background: var(--white);
    color: var(--violet);
    box-shadow: var(--shadow-sm);
  }

  /* On the transparent (hero-dark) header, lift contrast. */
  .site-header:not(.is-solid) .langtoggle {
    background: rgba(255, 255, 255, 0.12);
  }
  .site-header:not(.is-solid) .langtoggle button { color: var(--on-dark-soft); }
  .site-header:not(.is-solid) .langtoggle button:hover { color: #fff; }
  html[data-lang='ko'] .site-header:not(.is-solid) .langtoggle [data-set-lang='ko'],
  html:not([data-lang='ko']) .site-header:not(.is-solid) .langtoggle [data-set-lang='en'] {
    background: rgba(255, 255, 255, 0.92);
    color: var(--violet);
  }
</style>
