---
// Seonbae wordmark + the supplied brand mark. The transparent master is shared
// with the authenticated product through /logo.png.
interface Props {
  tone?: 'ink' | 'light';
  href?: string;
  class?: string;
}
const { tone = 'ink', href = '/', class: cls = '' } = Astro.props;
const wordColor = tone === 'light' ? 'var(--on-dark)' : 'var(--ink)';
---

<a href={href} class={`logo ${cls}`} aria-label={href === '/' ? 'Seonbae home' : 'About Seonbae'}>
  <img src="/logo.png" alt="" class:list={['logo__img', { 'logo__img--light': tone === 'light' }]} width="46" height="36" />
  <span class="logo__word" style={`color:${wordColor}`}>Seonbae</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .logo__img { width: 46px; height: 36px; flex: none; object-fit: contain; }
  /* The supplied reverse mark is the same silhouette, so the transparent
     master can be rendered white without loading a second large raster. */
  .logo__img--light { filter: brightness(0) invert(1); }
  .logo__word {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.32rem;
    letter-spacing: -0.03em;
  }
</style>
