---
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';

interface Props { entry: CollectionEntry<'testimonials'>; }
const { entry } = Astro.props;
const t = entry.data;
const stars = Array.from({ length: 5 }, (_, i) => i < t.rating);
---
<article class="tcard">
  <div class={`tcard__aside surface-${t.accent}`}>
    <Avatar name={t.name} accent={t.accent === 'violet' ? 'violet' : 'lavender'} size={72} ring={false} />
    <div class="tcard__who">
      <p class="tcard__name">{t.name}</p>
      <p class="tcard__context">{t.context}</p>
    </div>
    {t.subject && <span class="pill pill--outline tcard__subject">{t.subject}</span>}
  </div>
  <div class="tcard__body">
    <div class="stars" aria-label={`${t.rating} out of 5`}>
      {stars.map((on) => (
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 1.6l2.5 5.1 5.6.8-4 3.9.95 5.6L10 14.9 4.9 17l.95-5.6-4-3.9 5.6-.8z" fill={on ? '#ffbf65' : 'rgba(19,24,27,0.16)'}/></svg>
      ))}
    </div>
    <blockquote class="tcard__quote">{t.quote}</blockquote>
  </div>
</article>

<style>
  .tcard {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background: var(--white);
    height: 100%;
  }
  .tcard__aside {
    padding: clamp(22px, 3vw, 34px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }
  .tcard__name { font-family: var(--display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.02em; }
  .tcard__context { font-size: 0.9rem; color: var(--muted); margin-top: 2px; line-height: 1.4; }
  .tcard__subject { align-self: flex-start; background: rgba(255,255,255,0.55); }
  .tcard__body { padding: clamp(24px, 3vw, 38px); display: flex; flex-direction: column; justify-content: center; }
  .stars { display: flex; gap: 3px; margin-bottom: 16px; }
  .tcard__quote {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .tcard { grid-template-columns: 1fr; }
  }
</style>
